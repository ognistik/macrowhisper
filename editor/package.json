{
  "name": "macrowhisper-editor-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run schema:check && tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run schema:check && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "schema:generate": "node scripts/generate-schema.mjs",
    "schema:check": "node scripts/generate-schema.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-tabs": "1.1.13",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
